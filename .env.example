# ──────────────────────────────────────────────
# AI Research & Report Generation Agent — Environment
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# LLM Configuration (Google Gemini or OpenAI)
# Option A: Google Gemini (Recommended)
GOOGLE_API_KEY=your-gemini-api-key-here
LLM_MODEL_NAME=gemini-1.5-flash

# Option B: OpenAI
# OPENAI_API_KEY=your-openai-api-key-here
# LLM_MODEL_NAME=gpt-4o-mini

# Qdrant Vector Database
# Docker mode:
QDRANT_URL=http://localhost:6333
# Set to true if running without Docker:
QDRANT_PREFER_EMBEDDED=false

# PostgreSQL Checkpointer
# Docker mode:
POSTGRES_URL=postgresql://postgres:postgrespassword@localhost:5432/research_agent

# LangSmith Tracing (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=research-agent
