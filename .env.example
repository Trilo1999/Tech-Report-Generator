# ─────────────────────────────────────────────────────────────────────────────
# AI Research & Report Generation Agent (Built on Agentic Web Starter)
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# --- Application & Environment ---
ENV=dev
PROJECT_NAME=agentic_web_starter
PROJECT_VERSION=0.1.0
PROJECT_DESCRIPTION="An agentic retrieval-augmented generation application."
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
BASE_PATH=
WORKING_DIR=

# --- LLM API Keys & Model Config ---
# Hive AI (DeepSeek / Grounded Search & Synthesis)
HIVE_SECRET_KEY=
HIVE_ACCESS_KEY=
HIVE_REGIONAL_COMPLIANCE=true
HIVE_BASE_URL=https://api-regional.deploy.com/api/v1
HIVE_MODEL_NAME=deepseek-ai/deepseek-v4.1-flash-1017

# Google Gemini (Primary / Alternative)
GEMINI_API_KEY=
GOOGLE_API_KEY=
LLM_MODEL_NAME=gemini-1.5-flash

# OpenAI (Alternative)
OPENAI_API_KEY=

# --- JWT Authentication & IAM ---
JWT_SECRET_KEY=agentic-web-starter-jwt
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Admin Bootstrap (optional; created only if no users exist)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@antigravity.ai
ADMIN_PASSWORD=Admin@123

# --- Storage & Feature Switches ---
USE_QDRANT=true
USE_REDIS=false
USE_SQL=true
USE_RABBITMQ=false

# --- Vector Database (Qdrant) ---
QDRANT_URL=http://localhost:6333
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_PROTOCOL=http
QDRANT_PREFER_EMBEDDED=false
COLLECTION_NAME=research_documents
HF_HOME=

# --- Persistence & Checkpointing (PostgreSQL) ---
POSTGRES_URL=postgresql://postgres:postgrespassword@localhost:5432/research_agent

# --- Redis (Conversation Memory & Caching) ---
USE_REDIS=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PROTOCOL=redis
REDIS_PASSWORD=
REDIS_URL=
REDIS_CHAT_TTL_SECONDS=86400
REDIS_CACHE_TTL_SECONDS=3600
ENABLE_REDIS_LLM_CACHE=false

# --- RabbitMQ (Optional Async Queue) ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_AMQP_URL=
RABBITMQ_INGEST_QUEUE=agentic_web_starter.ingestion

# --- LangSmith Tracing (Optional) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=research-agent
